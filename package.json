{
    "name": "@cartesi/explorer",
    "version": "1.2.0",
    "private": true,
    "scripts": {
        "clean": "rm -rf node_modules && rm -rf .next",
        "dev": "run-s db:dev:migrate codegen next:dev",
        "build": "run-s db:prod:migrate codegen next:build",
        "start": "next start",
        "next:build": "next build",
        "next:dev": "next dev",
        "test": "dotenv -c test -- jest",
        "test:ci": "dotenv -c test -- jest --runInBand --coverage",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "db:dev:migrate": "dotenv -c development -- pnpm db:migrate",
        "db:prod:migrate": "dotenv -c production -- pnpm db:migrate",
        "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "lint": "eslint --color src",
        "lint:fix": "pnpm lint --fix",
        "chromatic": "chromatic --exit-zero-on-changes",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "chakra-types": "chakra typegen ./src/styles/theme.ts",
        "gen:abi": "wagmi generate",
        "codegen": "run-p chakra-types gen:abi"
    },
    "dependencies": {
        "@apollo/client": "4.3.5",
        "@chakra-ui/react": "^3.37.0",
        "@emotion/react": "^11.14.0",
        "@libsql/client": "^0.18.0",
        "@next/third-parties": "^16.4.2",
        "@rainbow-me/rainbowkit": "^2.2.11",
        "@supercharge/promise-pool": "3.3.0",
        "@tanstack/react-query": "^5.104.5",
        "@vercel/speed-insights": "^2.0.0",
        "chart.js": "^4.5.1",
        "date-fns": "^4.4.0",
        "drizzle-orm": "^0.45.4",
        "framer-motion": "^13.3.0",
        "graphql": "^17.0.2",
        "graphql-tag": "^2.12.7",
        "humanize-duration": "^3.35.0",
        "jotai": "^3.0.1",
        "lodash": "^4.18.1",
        "next": "^16.4.2",
        "next-themes": "^0.4.6",
        "react": "^19.3.1",
        "react-chartjs-2": "^5.3.1",
        "react-dom": "^19.3.1",
        "react-ga4": "^3.0.1",
        "react-hook-form": "^7.90.0",
        "react-icons": "^5.7.0",
        "react-is": "^19.3.1",
        "react-jazzicon": "^1.0.4",
        "recharts": "^3.10.1",
        "rxjs": "^7.8.2",
        "viem": "^2.57.7",
        "wagmi": "^2.19.5"
    },
    "devDependencies": {
        "@babel/core": "^8.0.5",
        "@cartesi/pos": "2.1.0",
        "@cartesi/pos-1.0": "npm:@cartesi/pos@1.0.0",
        "@cartesi/staking-pool": "2.1.1",
        "@cartesi/token": "1.9.0",
        "@cartesi/util": "5.0.2",
        "@chakra-ui/cli": "^3.37.0",
        "@chromatic-com/storybook": "^5.6.0",
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@storybook/addon-links": "^10.6.3",
        "@storybook/nextjs-vite": "^10.6.3",
        "@storybook/react": "^10.6.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/humanize-duration": "3.27.4",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.25",
        "@types/node": "^24",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@wagmi/cli": "^2.10.0",
        "babel-jest": "^30.5.1",
        "chromatic": "^18.13.0",
        "dotenv-cli": "11.0.0",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-storybook": "^10.6.3",
        "ethers": "^5.8.0",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^30.5.1",
        "jest-canvas-mock": "^2.5.8",
        "jest-environment-jsdom": "^30.5.1",
        "jest-mock-extended": "4.0.1",
        "npm-run-all2": "^9.0.3",
        "prettier": "3.9.6",
        "storybook": "^10.6.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.4"
    },
    "engines": {
        "node": "24.x"
    },
    "packageManager": "pnpm@11.27.1"
}
